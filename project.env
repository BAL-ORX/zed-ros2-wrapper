# Project-specific configuration — single source of truth for run_dev.sh and deploy.sh.
#
# When reusing this Isaac ROS setup in a new project, edit:
#   1. This file
#   2. scripts/.isaac-ros-cli/config.yaml   (container_name, additional_image_keys)
#   3. scripts/.build_image_layers.yaml     (image_key_order — must mirror additional_image_keys)
#   4. scripts/docker/Dockerfile.dependency (ROS/system dependencies)

# Image name used by CI to push/pull from the container registry
PROJECT_NAME="zed-ros2-wrapper"
REGISTRY="cr.gitlab.uzh.ch/bal-orx"

# Default ROS 2 launch target (overridable as the first argument to deploy.sh)
LAUNCH_PKG="zed_wrapper"
LAUNCH_FILE="orx_zed_camera.launch.py"
